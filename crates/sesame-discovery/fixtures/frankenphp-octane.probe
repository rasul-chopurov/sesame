@@SESAME supervisor_conf@@
; file: /etc/supervisor/conf.d/shop-octane.conf
[program:shop-octane]
command=php /var/www/shop/artisan octane:start --server=frankenphp --host=127.0.0.1 --port=8000 --admin-port=2020 --workers=4 --max-requests=500
directory=/var/www/shop
user=shop

; file: /etc/supervisor/conf.d/shop-queue.conf
[program:shop-queue]
process_name=%(program_name)s_%(process_num)02d
command=php /var/www/shop/artisan queue:work redis --sleep=1 --tries=3 --max-time=3600
directory=/var/www/shop
user=www-data
numprocs=2

; file: /etc/supervisor/conf.d/shop-reverb.conf
[program:shop-reverb]
command=php /var/www/shop/artisan reverb:start --host=127.0.0.1 --port=8080
directory=/var/www/shop
user=www-data

